# ===== Server =====
PORT=3000

# ===== MQTT =====
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_TOPIC=hvac/#

# ===== CORS =====
CORS_ORIGIN=*

# ===== App Timings =====
# Timeout in ms before a pending command is marked as TIMEOUT (default: 10000)
COMMAND_TIMEOUT_MS=10000
# Interval in ms for the connectivity check loop (default: 5000)
CONNECTIVITY_CHECK_MS=5000
# Time in ms without an update before a device is marked as DISCONNECTED (default: 60000)
DISCONNECT_TIMEOUT_MS=60000
