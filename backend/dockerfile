# ─── Development stage ────────────────────────────────────────────────────────
# Used by docker-compose (source is mounted as a volume; ts-node watch mode).
FROM node:20-alpine AS development
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
EXPOSE 3000
CMD ["npm", "run", "start:dev"]

# ─── Builder stage ─────────────────────────────────────────────────────────────
# Compiles TypeScript to /app/dist.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ─── Production stage ──────────────────────────────────────────────────────────
# Lean image: only production deps + compiled dist.
FROM node:20-alpine AS production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
EXPOSE 3000
CMD ["node", "dist/main"]
