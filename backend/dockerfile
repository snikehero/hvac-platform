# ─── Development stage ────────────────────────────────────────────────────────
# Used by docker-compose (source is mounted as a volume; ts-node watch mode).
FROM node:20-alpine AS development
WORKDIR /app
COPY package*.json ./
# Install deps into the image layer; the entrypoint re-runs npm ci at startup
# so the named volume gets populated even on a fresh mount.
RUN npm ci
COPY . .
EXPOSE 3000
# npm ci at startup populates the named volume if it's empty, then starts the app
CMD ["sh", "-c", "npm ci && npm run start:dev"]

# ─── Builder stage ─────────────────────────────────────────────────────────────
# Compiles TypeScript to /app/dist.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ─── Production stage ──────────────────────────────────────────────────────────
# Lean image: only production deps + compiled dist.
FROM node:20-alpine AS production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
EXPOSE 3000
CMD ["node", "dist/main"]
